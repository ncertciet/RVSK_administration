# APPLICATION
# ==========================================
APP_NAME=Administration Ingestion API
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=False
ENABLE_DOCS=False

HOST=0.0.0.0
PORT=8000
CORS_ALLOWED_ORIGINS=https://your-client-domain.example

# DATABASE
# ==========================================
DB_HOST=your-postgres-host
DB_PORT=5432
DB_NAME=administration
DB_USER=your-db-user
DB_PASSWORD=replace-with-secret-manager-value

DB_MIN_CONNECTIONS=5
DB_MAX_CONNECTIONS=20


# AUTH API
# ==========================================
AUTH_BASE_URL=https://your-auth-service.example/auth
PUBLIC_KEY_FILE=public.pem
JWT_ALGORITHM=RS256
AUTH_TIMEOUT_SECONDS=10


# INGESTION
# ==========================================
CHUNK_SIZE=5000
MAX_RECORDS_PER_REQUEST=100000


# LOGGING
# ==========================================
LOG_LEVEL=INFO

